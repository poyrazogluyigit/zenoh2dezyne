import Utils/Step.dzn;

interface IA {
    out void basic_B_A();

    behavior {
        on inevitable: basic_B_A;
    }
}

component A {

    provides IA A_top;
    requires IStep step;

    behavior {

        subint State {1..11};
        State s = 1;

        on step.step(): {
            [s == 1] s = 2;
            [s == 2] s = 3;
            [s == 3] s = 4;
            [s == 4] s = 5;
            [s == 5] s = 6;
            [s == 6] s = 7;
            [s == 7] s = 8;
            [s == 8] s = 9;
            [s == 9] s = 10;
            [s == 10] {
                A_top.basic_B_A(); s = 9;
            }
            /*
            [s == 10] {
                s = 11; 
            }
            [s == 11] exit();
            */
        }
    }
}