import A.dzn;
import B.dzn;
import C.dzn;
import Utils/Step.dzn;
import Network.dzn;

component Top {

    provides INetCtl net_ctl;

    system {

        // Network component
        Network net;
        net_ctl <=> net.ctl;

        // Stepper component
        Step step;
        net.clk <=> step.step;

        // Components of the system
        A A_comp;
        B B_comp;
        C C_comp;

        // network binding
        A_comp.A_top <=> net.A;
        B_comp.B_top <=> net.B;
        C_comp.C_top <=> net.C;
    }   
}