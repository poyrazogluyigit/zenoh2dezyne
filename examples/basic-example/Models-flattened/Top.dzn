import A.dzn;
import B.dzn;
import C.dzn;
import Utils/Step.dzn;
import Network.dzn;

component Top {

    provides INetCtl net_ctl;

    system {

        // Network component
        Network net;
        net_ctl <=> net.ctl;

        // Components of the system
        CA A_comp;
        CB B_comp;
        CC C_comp;

        // Steppers
        Step s1;
        Step s2;
        Step s3;

        // network binding
        A_comp.A_top <=> net.A;
        B_comp.B_top <=> net.B;
        C_comp.C_top <=> net.C;

        // Step function binding
        net.s1 <=> s1.step;
        net.s2 <=> s2.step;
        net.s3 <=> s3.step;
       
    }   
}