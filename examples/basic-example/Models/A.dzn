import Submodels/A_main.dzn;
import Utils/Step.dzn;

interface IA {
    out void basic_B_A();

    behavior {
        on inevitable: basic_B_A;
    }
}

component A {

    provides IA A_top;
    requires IA_MAIN main;
    requires IStep step;

    behavior {
        on main.B_pub(): A_top.basic_B_A();
        on step.step(): main.step();
    }

}