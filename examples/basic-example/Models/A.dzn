import Utils/Step.dzn;

interface IA {

    out void basic_B_A();
    in void step();

    behavior {

        subint State {1..11};
        State s = 1;

        on step: {
            [s == 1] s = 2;
            [s == 2] s = 3;
            [s == 3] s = 4;
            [s == 4] s = 5;
            [s == 5] s = 6;
            [s == 6] s = 7;
            [s == 7] s = 8;
            [s == 8] s = 9;
            [s == 9] s = 10;
            [s == 10] {
                basic_B_A; s = 9;
            }
            /*
            [s == 10] {
                s = 11; 
            }
            [s == 11] exit();
            */
        }
    }
}

component CA {
    provides IA A_top;
}