import Utils/Step.dzn;
import Submodels/B_main.dzn;
import Submodels/A_callback.dzn;
import Submodels/C_callback.dzn;

component B {

    out void basic_A_B();
    out void basic_C_B();

    in void basic_B_A();
    in void basic_B_C();

    provides B_main B_main;
    provides A_callback A_callback;
    provides C_callback C_callback;
    requires Step step;


    enum CurrentExecution {BMain, ACallback, CCallback};

    behavior {
        CurrentExecution cur = BMain;
        [cur.BMain] {
            on step.step(): B_main.step();
            on basic_B_A: cur = CurrentExecution.ACallback;
            on basic_B_C: cur = CurrentExecution.CCallback;

        }
        [cur.ACallback] {
            on step.step(): A_callback.step();
            on A_callback.A_pub(): basic_A_B();
            on A_callback.C_pub(): basic_C_B();
            on A_callback.exit(): cur = CurrentExecution.BMain;

        }
        [cur.CCallback] {
            on step.step(): C_Callback.step();
            on C_callback.exit(): cur = CurrentExecution.BMain;
        }

    }

}