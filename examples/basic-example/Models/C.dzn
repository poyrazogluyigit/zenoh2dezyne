import Utils/Step.dzn;
import Submodels/C_main.dzn;
import Submodels/AB_callback.dzn;

interface IC {

    out void basic_A_C();
    out void basic_B_C();

    in void basic_C_A();
    in void basic_C_B();

}

component C {

    provides IC C;
    provides C_main C_main;
    provides AB_callback AB_callback;
    requires Step step;


    behavior {
        enum CurrentExecution {CMain, ABCallback};
        CurrentExecution cur = CurrentExecution.CMain;
        [cur.CMain] {
            on step.step(): C_main.step();
            on C.basic_C_A(): cur = CurrentExecution.ABCallback;
            on C.basic_C_B(): cur = CurrentExecution.ABCallback;

        }
        [cur.ABCallback] {
            on step.step(): AB_callback.step();
            on AB_callback.A_pub(): C.basic_A_C();
            on AB_callback.B_pub(): C.basic_B_C();
            on AB_callback.exit(): cur = CurrentExecution.CMain;
        }
    }

}