interface IC_CB {
    in void step();
    out void exit();

    behavior {
        on step: {}
        on step: exit;
    }
}

component C_CB {

    provides IC_CB cb;

    behavior {
        subint State{1..2};
        State s = 1;
        on cb.step(): {
            [s == 1] s = 2;
            [s == 2] cb.exit();
        }
    }
}