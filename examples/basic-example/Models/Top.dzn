import A.dzn;
import B.dzn;
import C.dzn;
import Utils/Step.dzn;
import Network.dzn;
import Submodels/A_callback.dzn;
import Submodels/C_callback.dzn;
import Submodels/AB_callback.dzn;
import Submodels/A_main.dzn;
import Submodels/B_main.dzn;
import Submodels/C_main.dzn;

component Top {

    provides INetCtl net_ctl;

    system {

        // Network component
        Network net;
        net_ctl <=> net.ctl;

        // Components of the system
        A A_comp;
        B B_comp;
        C C_comp;

        // Steppers
        Step s1;
        Step s2;
        Step s3;

        // Component internals
        A_MAIN a_main;
        B_MAIN b_main;
        C_MAIN c_main;

        A_CB a_callback;
        AB_CB ab_callback;
        C_CB c_callback;

        // network binding
        A_comp.A_top <=> net.A;
        B_comp.B_top <=> net.B;
        C_comp.C_top <=> net.C;

        // Step function binding
        A_comp.step <=> s1.step;
        B_comp.step <=> s2.step;
        C_comp.step <=> s3.step;

        // Component internals binding
        A_comp.main <=> a_main.main;
        B_comp.B_main <=> b_main.main;
        C_comp.C_main <=> c_main.main;

        B_comp.A_callback <=> a_callback.cb;
        B_comp.C_callback <=> c_callback.cb;

        C_comp.AB_callback <=> ab_callback.cb;
    }   
}