import A.dzn;
import B.dzn;
import C.dzn;
import Utils/Step.dzn;
import Network.dzn;
import Submodels/A_callback.dzn;
import Submodels/C_callback.dzn;
import Submodels/AB_callback.dzn;
import Submodels/A_main.dzn;
import Submodels/B_main.dzn;
import Submodels/C_main.dzn;

component A_cb {
    provides A_callback cb;
}

component C_cb {
    provides C_callback cb;
}

component AB_cb {
    provides AB_callback cb;
}

component CStep {
    provides Step step;
}

component CA_main {
    provides A_main main;
}

component CB_main {
    provides B_main main;
}

component CC_main {
    provides C_main main;
}

component Top {

    system {

        // Network component
        Network net;

        // Components of the system
        A A_c;
        B B_c;
        C C_c;

        // Steppers
        CStep s1;
        CStep s2;
        CStep s3;

        // Component internals
        CA_main a_m;
        CB_main b_m;
        CC_main c_m;

        A_cb a_c;
        AB_cb ab_c;
        C_cb c_c;

        // network binding
        A_c.A_top <=> net.A;
        B_c.B_top <=> net.B;
        C_c.C_top <=> net.C;

        // Step function binding
        A_c.step <=> s1.step;
        B_c.step <=> s2.step;
        C_c.step <=> s3.step;

        // Component internals binding
        A_c.main <=> a_m.main;
        B_c.B_main <=> b_m.main;
        C_c.C_main <=> c_m.main;

        B_c.A_callback <=> a_c.cb;
        B_c.C_callback <=> c_c.cb;

        C_c.AB_callback <=> ab_c.cb;
    }   
}