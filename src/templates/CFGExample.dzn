interface ICFG {
    in void start();
    in void step();
    // out void exit(); 

    enum State {N1, N2, N3};

    behavior {
        State s = State.N1;
        bool running = false;
        // step() silinip iki behavior start'in altinda birlestirilebilir
        on start: {
            running = true;
            s = State.N1;
        }
        on step: {
            [!running] illegal;
            [running] {
                // state transitions
                [s.N1] s = State.N2;
                [s.N2] s = State.N3;
                [s.N3] s = State.N1;
            }
        }
        // if N3 is the exit node, the program must eventually exit
        // eger cikis kosullari modellenebiliyorsa buraya eklenir, yoksa
        // inevitable deyip gecilir

        /* on inevitable: {
            [running && s.N3] {
                running = false;
                exit;
            }
        } */
    }
}