import ILoop.dzn;

component LoopComponent {
    provides ILoop loop;
    behavior {
        bool loopVar = false;
        on loop.startLoop(): {
            // Initialize loop variables
            loopVar = true;
        }
        [loop.isRunning]
            // FIXME inevitable not allowed in components
            on inevitable: {
            // loop condition
            if (!loopVar) {
                loop.endLoop();
            }
            // Loop body
            loop.loopIteration();
        }
    }
}