interface example {
    in void a();
    in void b();
    enum State {GET_COMM, ACT};

    behavior {

        State s = State.ACT;
        bool a_on = false;

        bool b_on = true;
        bool b_looping = false;

        bool dummy = false;
    
        [s.GET_COMM] {
            on a: {
                a_on = true;
                s = State.ACT;
            }
            on b: {
                b_on = true;
                s = State.ACT;

            }
            on inevitable:
                s = State.ACT;
        } 
        [s.ACT] {
            [a_on] {
                // ...
                dummy = true;
                s = State.GET_COMM;
            }
            // suppose callback of b contains loops
            [b_on] {
                // ...
                dummy = false;
                s = State.GET_COMM;
            }
            // main loop
            [otherwise] {
                // ...
                dummy = true;
                s = State.GET_COMM;
            }
        }
    }
}